# FitSphere app: local settings. Names only; no values are committed.
# Copy this file to .env in the same folder (ignored by git) and fill in the values yourself.
# Expo builds every EXPO_PUBLIC_ value into the app in plain text: never put a secret here,
# and never the Supabase secret key (sb_secret_...) or the service_role key.
# What each value is and where to find it: docs/operations/runbook.md#configuration-names

# https://<project-ref>.supabase.co (the same value as the API's SUPABASE_URL)
EXPO_PUBLIC_SUPABASE_URL=

# Supabase dashboard > Settings > API Keys > publishable key (sb_publishable_...)
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Address of the API as the phone reaches it during development. How the phone reaches the
# API on this PC is the owner's choice under D-19 (runbook, step 8); until then, leave it empty.
EXPO_PUBLIC_API_URL=
