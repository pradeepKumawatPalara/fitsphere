{
  "expo": {
    "name": "FitSphere",
    "slug": "fitsphere",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "fitsphere",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fitsphere.app"
    },
    "android": {
      "package": "com.fitsphere.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "FitSphere uses the camera to scan barcodes on food packs and to take meal photos.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "FitSphere uses the photo you choose as a meal photo.",
          "cameraPermission": "FitSphere uses the camera to scan barcodes on food packs and to take meal photos.",
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "90ea3845-7699-4107-99a8-122a76e85a42"
      }
    },
    "owner": "fits_phere"
  }
}
