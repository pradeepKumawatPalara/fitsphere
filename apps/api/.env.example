# FitSphere API: local settings. Names only; no values are committed.
# Copy this file to .env in the same folder (ignored by git) and fill in the values yourself.
# What each value is and where to find it: docs/operations/runbook.md#configuration-names
# Never paste these values into chat, issues, commits or screenshots.

# SECRET (contains the database password). Used by the API, migrate and db:growth.
# Supabase dashboard > Connect > Session pooler (port 5432), with [YOUR-PASSWORD] replaced.
DATABASE_URL=

# https://<project-ref>.supabase.co (Supabase dashboard > Connect)
SUPABASE_URL=

# Not secret. Supabase dashboard > Settings > API Keys > publishable key (sb_publishable_...).
# Never the secret key (sb_secret_...) or the legacy service_role key.
SUPABASE_PUBLISHABLE_KEY=

# Not secret. Your contact address for Open Food Facts' User-Agent ("FitSphere/1.0 (address)"),
# as Open Food Facts asks. Without it, barcode lookups answer 503 (runbook, "Configuration names").
OFF_CONTACT=

# Meal photo storage (ADR-0002 rule 4), through Supabase Storage's S3 connection. Without all
# five, photo links answer 503. Copy the names exactly: the four connection names contain _S3_,
# STORAGE_BUCKET does not. Where each value comes from (runbook step 5, item 9):
# - STORAGE_BUCKET: the name of the private bucket you create with "New bucket";
# - STORAGE_S3_ENDPOINT and STORAGE_S3_REGION: shown on the S3 connection settings;
# - STORAGE_S3_ACCESS_KEY_ID and STORAGE_S3_SECRET_ACCESS_KEY: from "New access key".
# npm run check:storage needs these five and SUPABASE_URL.
STORAGE_S3_ENDPOINT=
STORAGE_S3_REGION=
STORAGE_BUCKET=
# Not secret on its own, but kept with its secret below.
STORAGE_S3_ACCESS_KEY_ID=
# SECRET. Full access to every bucket, bypassing storage policies; server only, never in the app.
STORAGE_S3_SECRET_ACCESS_KEY=

PORT=3000
LOG_LEVEL=info

# Local PostgreSQL for automated tests, synthetic data only; never the Supabase project.
# For example postgres://postgres:<local-password>@localhost:5432/fitsphere_test
TEST_DATABASE_URL=
