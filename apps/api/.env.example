# FitSphere API: local settings. Names only; no values are committed.
# Copy this file to .env in the same folder (ignored by git) and fill in the values yourself.
# What each value is and where to find it: docs/operations/runbook.md#configuration-names
# Never paste these values into chat, issues, commits or screenshots.

# SECRET (contains the database password). Used by the API, migrate and db:growth.
# Supabase dashboard > Connect > Session pooler (port 5432), with [YOUR-PASSWORD] replaced.
DATABASE_URL=

# https://<project-ref>.supabase.co (Supabase dashboard > Connect)
SUPABASE_URL=

# Not secret. Supabase dashboard > Settings > API Keys > publishable key (sb_publishable_...).
# Never the secret key (sb_secret_...) or the legacy service_role key.
SUPABASE_PUBLISHABLE_KEY=

PORT=3000
LOG_LEVEL=info

# Local PostgreSQL for automated tests, synthetic data only; never the Supabase project.
# For example postgres://postgres:<local-password>@localhost:5432/fitsphere_test
TEST_DATABASE_URL=
