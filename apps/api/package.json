{
  "name": "@fitsphere/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.ts",
    "start": "node --env-file-if-exists=.env src/server.ts",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run src scripts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.ts",
    "db:growth": "node --env-file-if-exists=.env scripts/db-growth.ts",
    "check:data-api": "node --env-file-if-exists=.env scripts/check-data-api.ts",
    "check:signup": "node --env-file-if-exists=.env scripts/check-signup.ts",
    "check:storage": "node --env-file-if-exists=.env scripts/check-storage.ts",
    "foods:import": "node --env-file-if-exists=.env scripts/foods-import.ts",
    "exercises:import": "node --env-file-if-exists=.env scripts/exercises-import.ts",
    "usda:convert": "node scripts/usda-convert.ts",
    "indb:convert": "node scripts/indb-convert.ts",
    "off:convert": "node scripts/off-convert.ts",
    "exercise-details:convert": "node scripts/exercise-details-convert.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1159.0",
    "@aws-sdk/s3-request-presigner": "^3.1159.0",
    "@fitsphere/shared": "*",
    "fastify": "^5.12.7",
    "jose": "^6.2.13",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "vitest": "^5.0.5"
  }
}
