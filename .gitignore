# OS / editor
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# Secrets — never commit
.env
.env.*
!.env.example
*.pem
*.key

# Claude Code local-only settings
.claude/settings.local.json

# Dependencies and build output
node_modules/
dist/
coverage/
*.tsbuildinfo

# Expo: caches, and the native projects generated at build time (ADR-0001)
.expo/
apps/mobile/android/
apps/mobile/ios/

# npm run dev:phone: the API and tunnel output (the tunnel log holds its address)
.dev-phone/

# Source PDFs read for the food data: never committed, because of their publishers' terms. The
# originals are kept outside the repository; docs/sources/README.md lists them with their hashes.
docs/sources/*.pdf
